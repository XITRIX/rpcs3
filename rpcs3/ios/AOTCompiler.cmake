# Normal Mac, visionOS, Simulator and legacy startup do not require the
# optional compiler. Simulator-native AOT integration tests are explicit opt-in.
# Library revisions/archives remain separate from the pinned LLVM distribution.
set(RPCS3_IOS_AOT_LINKER_ROOT "" CACHE PATH "Verified static Mach-O linker")
option(RPCS3_AOT_HOST_TESTS "Build isolated native recompiler tests on macOS" OFF)
option(RPCS3_AOT_SIMULATOR_TESTS "Build isolated AOT tests with Simulator-native dependencies" OFF)
if(RPCS3_AOT_SIMULATOR_TESTS AND (NOT CMAKE_SYSTEM_NAME STREQUAL "iOS" OR NOT CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator" OR RPCS3_IOS_LEGACY_COMPATIBILITY))
    message(FATAL_ERROR "AOT Simulator test tooling requires a modern Simulator target")
endif()
if(RPCS3_IOS_AOT_LINKER_ROOT)
    if(RPCS3_AOT_HOST_TESTS AND CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set(aot_platform macosx)
        set(aot_floor 14.0)
    elseif(RPCS3_AOT_SIMULATOR_TESTS AND CMAKE_SYSTEM_NAME STREQUAL "iOS" AND CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator" AND NOT RPCS3_IOS_LEGACY_COMPATIBILITY)
        set(aot_platform iphonesimulator)
        set(aot_floor 15.0)
        target_compile_definitions(RPCS3Core PRIVATE RPCS3_IOS_AOT_SIMULATOR=1)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS" AND NOT CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator" AND NOT RPCS3_IOS_LEGACY_COMPATIBILITY)
        set(aot_platform iphoneos)
        set(aot_floor 15.0)
    else()
        message(FATAL_ERROR "The AOT compiler requires modern iPhoneOS or explicitly enabled native test tooling")
    endif()
    file(READ "${RPCS3_IOS_AOT_LINKER_ROOT}/aot-linker-manifest.json" manifest)
    foreach(field IN ITEMS llvm_revision builder_revision platform minimum_os)
        string(JSON "${field}" GET "${manifest}" "${field}")
    endforeach()
    if(NOT llvm_revision STREQUAL "ca7933e47d3a3451d81e72ac174dcb5aa28b59d1" OR
       NOT builder_revision STREQUAL "ec81b2304bcb9373eb4ffb0fc43333c28e7c44be" OR
       NOT platform STREQUAL aot_platform OR NOT minimum_os STREQUAL aot_floor)
        message(FATAL_ERROR "Unexpected AOT linker dependency identity/platform")
    endif()
    foreach(library IN ITEMS lldMachO lldCommon)
        set(archive "${RPCS3_IOS_AOT_LINKER_ROOT}/lib/lib${library}.a")
        file(SHA256 "${archive}" actual)
        string(JSON expected GET "${manifest}" libraries "lib${library}.a")
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "AOT linker archive digest mismatch: ${library}")
        endif()
        add_library("rpcs3_aot_${library}" STATIC IMPORTED)
        set_target_properties("rpcs3_aot_${library}" PROPERTIES IMPORTED_LOCATION "${archive}")
    endforeach()
    target_sources(RPCS3Core PRIVATE ios/AOTCompiler.cpp ios/AOTObjectWriter.cpp ios/AOTService.cpp ios/AOTAnalysis.cpp ios/AOTRecompiler.cpp)
    # Only the LLVM-facing emitter needs LLVM's RTTI policy. On Darwin a
    # -fno-rtti service emits exception type metadata without base relationships,
    # so even std::runtime_error can miss the C API's std::exception catch.
    set_source_files_properties(ios/AOTCompiler.cpp ios/AOTObjectWriter.cpp ios/AOTRecompiler.cpp PROPERTIES COMPILE_OPTIONS "-fexceptions;-fno-rtti")
    set_source_files_properties(ios/AOTService.cpp ios/AOTAnalysis.cpp PROPERTIES COMPILE_OPTIONS "-fexceptions")
    target_compile_definitions(RPCS3Core PRIVATE RPCS3_IOS_AOT_COMPILER=1)
    target_include_directories(RPCS3Core PRIVATE "${RPCS3_IOS_AOT_LINKER_ROOT}/include")
    target_link_libraries(RPCS3Core PRIVATE rpcs3_aot_lldMachO rpcs3_aot_lldCommon)
    if(RPCS3_AOT_HOST_TESTS OR RPCS3_AOT_SIMULATOR_TESTS)
        get_target_property(core_sources RPCS3Core SOURCES)
        get_target_property(core_includes RPCS3Core INCLUDE_DIRECTORIES)
        get_target_property(core_definitions RPCS3Core COMPILE_DEFINITIONS)
        get_target_property(core_libraries RPCS3Core LINK_LIBRARIES)
        add_executable(rpcs3_aot_native_tests EXCLUDE_FROM_ALL ${core_sources} ios/tests/AOTNativeRecompilerTests.cpp ios/tests/AOTNativeAnalysisTests.cpp ios/tests/AOTNativeABIProof.cpp)
        target_include_directories(rpcs3_aot_native_tests PRIVATE ${core_includes})
        target_compile_definitions(rpcs3_aot_native_tests PRIVATE ${core_definitions} RPCS3_AOT_HOST_TESTS=1)
        target_link_libraries(rpcs3_aot_native_tests PRIVATE ${core_libraries})
        target_link_options(rpcs3_aot_native_tests PRIVATE "LINKER:-dead_strip")
        if(RPCS3_AOT_SIMULATOR_TESTS)
            target_compile_definitions(rpcs3_aot_native_tests PRIVATE RPCS3_IOS_AOT_SIMULATOR=1)
        endif()
        set_source_files_properties(ios/tests/AOTNativeRecompilerTests.cpp ios/tests/AOTNativeAnalysisTests.cpp ios/tests/AOTNativeABIProof.cpp PROPERTIES COMPILE_OPTIONS "-fexceptions;-fno-rtti")
    endif()
endif()
